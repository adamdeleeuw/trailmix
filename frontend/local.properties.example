# Path to your Android SDK. Android Studio usually writes this for you.
sdk.dir=/path/to/Android/sdk

# Backend base URL baked into the APK at build time.
#   Deployed backend (GCP VM):   https://136-67-54-50.sslip.io
#   Backend on your machine:     http://10.0.2.2:3000  (emulator; debug builds only)
API_BASE_URL=https://136-67-54-50.sslip.io

# Google OAuth client ID.
GOOGLE_CLIENT_ID=

# Other API keys, secrets, and configurations
MAPS_API_KEY=

# Key with Places API (New) enabled, for the Map tab's search. Restrict it to this app's
# package and signing certificate. Leave empty to use MAPS_API_KEY if that key has Places too.
PLACES_API_KEY=
