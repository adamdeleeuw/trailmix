# Google Auth
GOOGLE_BACKEND_CLIENT_ID=

# Google Routes API (chained route planning)
GOOGLE_ROUTES_API_KEY=

# Google Places API (optional bike-station discovery fallback)
GOOGLE_PLACES_API_KEY=

# Bike-transit routing and station candidate discovery
MAX_BICYCLE_LEG_DISTANCE_METERS=5000
BIKE_STATION_CANDIDATE_COUNT=3
BIKE_TO_TRANSIT_BUFFER_SECONDS=120
TRANSIT_TO_BIKE_BUFFER_SECONDS=120

# MongoDB (Used by npm run dev. Docker compose replaces this for prod.)
MONGODB_URI=

# TransLink Open API (live trip updates and service alerts, #87). Capped at ~950 requests a day.
TRANSLINK_API_KEY=
