# Google Auth
GOOGLE_BACKEND_CLIENT_ID=

# Google Routes API (chained route planning)
GOOGLE_ROUTES_API_KEY=

# Google Places API (optional bike-station discovery fallback)
GOOGLE_PLACES_API_KEY=

# Bike-transit station candidate discovery
BIKE_STATION_MAX_CYCLING_DISTANCE_METERS=5000
BIKE_STATION_CANDIDATE_COUNT=3

# MongoDB (Used by npm run dev. Docker compose replaces this for prod.)
MONGODB_URI=
